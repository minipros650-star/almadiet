# AlmaDiet backend configuration template.
# Copy to .env and fill in real values. NEVER commit .env.

# ── Environment ───────────────────────────────────────────────
# development | production. In production, startup FAILS if any
# required secret below is missing or insecure (enforced in app/config.py).
ENVIRONMENT=development

# ── Database ──────────────────────────────────────────────────
# PostgreSQL (production). SQLite is supported for local tests only.
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/almadiet

# ── JWT / sessions ────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=<generate-a-long-random-value-see-comment-above>
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated exact origin allowlist. Wildcards are REJECTED in
# production. Example: https://almadiet.example.com,https://app.example.com
ALLOWED_ORIGINS=http://localhost:3000

# ── Server ────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
# Never enable DEBUG in production.
DEBUG=false

# ── Content governance ────────────────────────────────────────
# Content states included in recommendation flows (comma-separated).
# Production must not include DRAFT or REVIEW_REQUIRED.
CONTENT_INCLUDE_STATUSES=REVIEWED,PUBLISHED
