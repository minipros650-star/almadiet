# ── Secrets / environment (never commit) ─────────────────────
.env
.env.*
!.env.example
frontend/env.local.json

# ── Local databases (never commit) ───────────────────────────
*.db
*.sqlite
*.sqlite3

# ── Vercel local state ───────────────────────────────────────
.vercel/

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
venv/
.venv/

# ── ML model artifacts ───────────────────────────────────────
backend/app/ml/*.pkl
backend/app/ml/*.joblib

# ── Flutter ──────────────────────────────────────────────────
.dart_tool/
build/
frontend/.dart_tool/
frontend/.packages
frontend/build/
frontend/.flutter-plugins
frontend/.flutter-plugins-dependencies
frontend/android/.gradle/
frontend/android/local.properties
frontend/windows/flutter/ephemeral/

# ── IDE / OS ─────────────────────────────────────────────────
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db
desktop.ini

# ── Docker / tooling state ───────────────────────────────────
pgdata/
.freebuff/
